{
  "name": "kamran-academic-portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Muhammad Kamran Ashraf — physical chemistry research and scientific software portfolio",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-content.mjs && node scripts/generate-artifacts.mjs && next build --webpack && node scripts/check-export.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "export:check": "node scripts/check-export.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/content-validation.test.mjs tests/export-validation.test.mjs",
    "format": "prettier --write app components content lib scripts/*.mjs tests/*.mjs *.json *.mjs *.js docs/*.md"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
